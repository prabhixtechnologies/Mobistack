{
  "name": "mobistack-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "apk": "expo prebuild --platform android && node ./scripts/assemble-apk.js",
    "apk:debug": "expo prebuild --platform android && node ./scripts/assemble-apk.js debug",
    "aab": "expo prebuild --platform android && node ./scripts/assemble-apk.js",
    "ios:project": "node ./scripts/assemble-ios.js",
    "ios:build": "node ./scripts/assemble-ios.js --require-binary",
    "ios:eas": "npx eas-cli build -p ios --profile preview",
    "ios:eas-device": "npx eas-cli build -p ios --profile preview-device"
  },
  "dependencies": {
    "expo": "^57.0.0",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.12",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "decode-uri-component": "^0.5.0",
    "typescript": "~5.9.2",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1",
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
