{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_IDENTITY_ISSUER": "http://localhost:8081",
        "EXPO_PUBLIC_API_URL": "http://localhost:8085"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_IDENTITY_ISSUER": "https://api.prabhixtechnologies.com",
        "EXPO_PUBLIC_API_URL": "https://mobistack.prabhixtechnologies.com"
      }
    },
    "preview-device": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_IDENTITY_ISSUER": "https://api.prabhixtechnologies.com",
        "EXPO_PUBLIC_API_URL": "https://mobistack.prabhixtechnologies.com"
      }
    },
    "production": {
      "channel": "production",
      "android": { "buildType": "apk" },
      "ios": {},
      "env": {
        "EXPO_PUBLIC_IDENTITY_ISSUER": "https://api.prabhixtechnologies.com",
        "EXPO_PUBLIC_API_URL": "https://mobistack.prabhixtechnologies.com"
      }
    }
  }
}
