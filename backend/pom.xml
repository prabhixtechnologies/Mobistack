<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.fixflow</groupId>
    <artifactId>fixflow-backend</artifactId>
    <version>0.1.0</version>
    <name>fixflow-backend</name>
    <description>MobiStack - Mobile Repair Shop Management Platform (API)</description>

    <properties>
        <!-- 25, the current LTS, matching the platform and Identity so one JDK covers the whole
             fleet. The Expo/React Native app is unaffected; it does not run on a JVM at all. -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          3.x is the line that targets Boot 4; 2.8.x reads
          org.springframework.boot.autoconfigure.web.servlet.WebMvcProperties, which Boot 4 moved, so
          SwaggerConfig fails to introspect and the context does not start. Not a compile error —
          springdoc is only on the classpath — so the integration test is what catches it.
        -->
        <springdoc.version>3.1.0</springdoc.version>
        <identity-client.version>1.0.0</identity-client.version>
        <!-- Same AWS SDK line as Identity/oneOps so CloudWatch export talks to the same API. -->
        <awssdk.version>2.29.52</awssdk.version>
        <!--
          Testcontainers is version-managed by the Boot parent from 4.x onwards, so the pin is gone
          and the modules below inherit it. Pinning it separately is how a build ends up resolving a
          Testcontainers that the managed JUnit does not match.
        -->
    </properties>

    <dependencies>
        <!--
          webmvc, not web. spring-boot-starter-web still resolves in Boot 4 but is deprecated for
          removal, and it is the classic aggregate: it drags in HTTP clients and JSON support that
          this module may or may not want, which is the coupling the 4.x split exists to undo.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!--
          webmvc no longer brings a JSON library, so the mapper that serialises every response has to
          be asked for explicitly. Omitting it does not fail the build; it produces controllers that
          cannot write their return values.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          Boot 4 does not auto-configure CloudWatch export. Wired in CloudWatchMetricsConfiguration
          when CLOUDWATCH_METRICS=true (or profile cloudwatch). Off by default so tests stay local.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-cloudwatch2</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>cloudwatch</artifactId>
            <version>${awssdk.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!--
          The starter rather than flyway-core on its own: Boot 4 moved Flyway's auto-configuration out
          of the monolithic autoconfigure jar into spring-boot-flyway, which only the starter pulls.
          With bare flyway-core the migrations silently do not run at startup.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Bearer tokens are verified against Prabhix Identity's published RS256 keys by this starter;
          MobiStack no longer signs or verifies anything itself. It also carries jjwt 0.12.6
          (api at compile scope, impl and jackson at runtime), which is why jjwt is not declared here
          any more: declaring it again at test scope would win Maven's nearest-wins mediation and pull
          the api jar off the runtime classpath. The filter test signs its tokens with that transitive
          copy.
        -->
        <dependency>
            <groupId>com.prabhix</groupId>
            <artifactId>identity-spring-boot-starter</artifactId>
            <version>${identity-client.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          Tests. The per-technology test starters replace the single spring-boot-starter-test, which
          they all bring transitively anyway. This is not cosmetic: in Boot 4 the test
          auto-configuration ships alongside each technology, so @WithMockUser and friends need
          spring-boot-starter-security-test to be on the classpath to do anything, and the old
          arrangement left them quietly inert.
        -->
        <!--
          Kept after the Boot 4 upgrade rather than removed with it. Boot ignores a configuration key
          it no longer recognises without saying anything, so a renamed property does not fail, it just
          silently reverts to the default — which is how server.error.include-stacktrace stopped being
          configured here and nothing noticed. Test scope, so it costs production nothing and reports
          in the build instead.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-properties-migrator</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Testcontainers 2.x, which Boot 4 manages, renamed every module to carry a testcontainers-
          prefix: org.testcontainers:postgresql stops at 1.21.4 and does not exist at 2.x at all.
          ${testcontainers.version} is inherited from the Boot parent rather than declared here so the
          modules always match the Testcontainers that Boot's own test support was built against; Boot
          sets the property but does not list these artifacts in its dependency management, hence the
          explicit version.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      identity-spring-boot-starter is published to GitHub Packages from the Identity repository.
      CI authenticates through actions/setup-java with server-id "github"; a laptop puts the same
      server id and a token with read:packages in ~/.m2/settings.xml. The offline path is to build
      it locally: mvn -f Identity/client/pom.xml install.
    -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/prabhixtechnologies/Identity</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Sets the groupId:artifactId:type properties surefire uses to locate the agent jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Integration tests need Docker (Testcontainers); opt in with -Pintegration -->
                    <excludedGroups>integration</excludedGroups>
                    <!-- Loads Mockito's agent at startup instead of letting it attach to a running
                         JVM, which the JDK warns about now and will refuse later. -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Production still targets 25. Maven on many laptops uses JAVA_HOME 17, which cannot
          emit release 25. Below 25, emit 17 bytecode; a 25 runtime still gets JVM features.
        -->
        <profile>
            <id>jdk-below-25</id>
            <activation>
                <jdk>[1.8,25)</jdk>
            </activation>
            <properties>
                <java.version>17</java.version>
            </properties>
        </profile>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!--
                              combine.self, because Maven treats an empty leaf element as "not set"
                              and keeps the inherited value. Without it the profile parsed fine and
                              changed nothing: -Pintegration still excluded the `integration` group.

                              Nothing is tagged with that group here yet — unlike the platform and
                              Identity, this module has no Testcontainers test — so the profile is
                              currently inert either way. Fixed rather than deleted because the first
                              test tagged `integration` would otherwise be silently skipped by the
                              profile written to run it, and a skipped test reports as a pass.
                            -->
                            <excludedGroups combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Writes backend/apidocs.json from a running instance (SWAGGER_ENABLED=true).

            $env:SWAGGER_ENABLED='true'; mvn spring-boot:run "-Dspring-boot.run.profiles=dev"
            mvn -Pgenerate-openapi springdoc-openapi:generate
        -->
        <profile>
            <id>generate-openapi</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springdoc</groupId>
                        <artifactId>springdoc-openapi-maven-plugin</artifactId>
                        <version>1.5</version>
                        <configuration>
                            <apiDocsUrl>http://localhost:8080/v3/api-docs</apiDocsUrl>
                            <outputFileName>apidocs.json</outputFileName>
                            <outputDir>${project.basedir}</outputDir>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
