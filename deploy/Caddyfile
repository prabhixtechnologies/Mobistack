{
	email {$ACME_EMAIL}
}

# www is omitted until an A/AAAA record exists. Caddy would otherwise retry ACME and hit rate limits.

mobistack.prabhixtechnologies.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com https://checkout.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /actuator/health* {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy web:80
	}
}
