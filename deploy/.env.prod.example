# Copy to the EC2 repo root as `.env` — never commit the real file.
#   cp deploy/.env.prod.example .env

DOCKERHUB_NAMESPACE=prabhixtechnologies
IMAGE_TAG=latest

POSTGRES_DB=fixflow
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Generate: openssl rand -base64 64
FIXFLOW_SECURITY_JWT_SECRET=

ACME_EMAIL=ops@prabhixtechnologies.com

FIXFLOW_WEB_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_PUBLIC_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_API_ORIGIN=https://mobistack.prabhixtechnologies.com

# Optional app packages served at /download/android and /download/ios
# Drop the files in ./downloads on the server (MobiStack.apk / MobiStack.ipa).
FIXFLOW_ANDROID_APK_PATH=/var/mobistack/downloads/MobiStack.apk
FIXFLOW_IOS_IPA_PATH=/var/mobistack/downloads/MobiStack.ipa

# Optional integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
FIXFLOW_GOOGLE_CLIENT_ID=
FIXFLOW_GOOGLE_CLIENT_SECRET=
FIXFLOW_OPENAI_API_KEY=

# Razorpay Standard Checkout (KEY_SECRET stays on the server).
# All three are required in prod: payment decides whether a workspace can work
# at all, and without the webhook secret a payment that succeeds at Razorpay
# never reaches us, so the shop stays locked after paying.
# The webhook secret is the one you typed into the Razorpay dashboard under
# Settings -> Webhooks for https://mobistack.prabhixtechnologies.com/api/v1/billing/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMTP — required for email OTP, password reset, and monthly billing reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@prabhixtechnologies.com
SMTP_AUTH=true
SMTP_STARTTLS=true
