# Copy to the EC2 repo root as `.env` — never commit the real file.
#   cp deploy/.env.prod.example .env

# Amazon ECR is the only registry; the instance role authenticates the pull.
REGISTRY=029096972251.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=latest

POSTGRES_DB=mobistack
POSTGRES_USER=mobistack
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Generate: openssl rand -base64 64
FIXFLOW_SECURITY_JWT_SECRET=

ACME_EMAIL=ops@prabhixtechnologies.com

FIXFLOW_WEB_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_PUBLIC_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_API_ORIGIN=https://mobistack.prabhixtechnologies.com

# Android APKs are published only on the company store (S3-backed). This URL is what /app and
# force-update policies advertise — MobiStack itself never streams the APK.
FIXFLOW_ANDROID_DOWNLOAD_URL=https://store.prabhixtechnologies.com/mobistack/android.apk
# Optional iOS package still served from this host when present.
# Drop MobiStack.ipa in ./downloads on the server.
FIXFLOW_IOS_IPA_PATH=/var/mobistack/downloads/MobiStack.ipa
FIXFLOW_IOS_DOWNLOAD_URL=https://mobistack.prabhixtechnologies.com/download/ios

# Optional integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
FIXFLOW_GOOGLE_CLIENT_ID=
FIXFLOW_GOOGLE_CLIENT_SECRET=
FIXFLOW_OPENAI_API_KEY=

# Razorpay Standard Checkout (KEY_SECRET stays on the server).
# KEY_ID and KEY_SECRET are required in prod: payment decides whether a
# workspace can work at all.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but recommended. Create the webhook in the Razorpay dashboard under
# Settings -> Webhooks pointing at
#   https://mobistack.prabhixtechnologies.com/api/v1/billing/webhooks/razorpay
# with the payment.captured and payment.failed events, then paste the secret
# you chose there. Without it, a customer who pays and closes the tab before
# the browser confirms stays locked out until someone reconciles by hand.
RAZORPAY_WEBHOOK_SECRET=

# SMTP — required for email OTP, password reset, and monthly billing reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@prabhixtechnologies.com
SMTP_AUTH=true
SMTP_STARTTLS=true
