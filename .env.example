# Copy values into your shell or a local .env that is never committed.
# EC2: start from deploy/.env.prod.example instead.

# Image registry. Amazon ECR is the only one; the Docker Hub account is gone. Both images live
# under the shared prabhix/ namespace inside it, so compose composes REGISTRY with prabhix/.
REGISTRY=029096972251.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=latest

# Canonical public site
FIXFLOW_WEB_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_PUBLIC_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_API_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_REQUIRE_HTTPS=true
ACME_EMAIL=ops@prabhixtechnologies.com

# JWT — at least 64 characters in every non-dev profile
FIXFLOW_SECURITY_JWT_SECRET=

# Prabhix Identity — blank issuer keeps HS256-only verification (local/dev without Identity).
# Set IDENTITY_ISSUER to the public issuer URL to accept RS256 tokens as well.
IDENTITY_ISSUER=
IDENTITY_JWKS_URI=
IDENTITY_SERVICE_TOKEN=

# Redis / Valkey
FIXFLOW_REDIS_ENABLED=true
# Local development against a Redis container.
REDIS_HOST=localhost
REDIS_PORT=6379
# Production only, read when the `valkey` profile is active. Serverless endpoint of the `mobistack`
# ElastiCache cache as host:port — a separate cache from the one the Prabhix services share.
#
#   aws elasticache describe-serverless-caches --region ap-south-1 \
#     --query 'ServerlessCaches[?ServerlessCacheName==`mobistack`].Endpoint.Address' --output text
REDIS_CLUSTER_NODES=

# Twilio — SMS and WhatsApp OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_DEFAULT_COUNTRY_CODE=91

# Optional Google SSO
FIXFLOW_GOOGLE_CLIENT_ID=
FIXFLOW_GOOGLE_CLIENT_SECRET=

# Optional chatbot model. Without this the in-app assistant uses MobiStack FAQs.
FIXFLOW_OPENAI_API_KEY=
FIXFLOW_OPENAI_MODEL=gpt-4o-mini

# Optional Expo Updates URL after `eas init`
FIXFLOW_EXPO_UPDATES_URL=

# Razorpay Standard Checkout — KEY_SECRET is server-only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP — required in production for email OTP, magic links, and billing reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@prabhixtechnologies.com
SMTP_AUTH=true
SMTP_STARTTLS=true
