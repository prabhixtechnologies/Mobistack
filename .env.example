# Copy values into your shell or a local .env that is never committed.

# Canonical public site
FIXFLOW_WEB_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_PUBLIC_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_API_ORIGIN=https://mobistack.prabhixtechnologies.com
FIXFLOW_REQUIRE_HTTPS=true
ACME_EMAIL=ops@prabhixtechnologies.com

# JWT — at least 64 characters in every non-dev profile
FIXFLOW_SECURITY_JWT_SECRET=

# Redis
FIXFLOW_REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# Twilio — SMS and WhatsApp OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_DEFAULT_COUNTRY_CODE=91

# Optional Google SSO
FIXFLOW_GOOGLE_CLIENT_ID=
FIXFLOW_GOOGLE_CLIENT_SECRET=

# Optional chatbot model. Without this the in-app assistant uses FixFlow FAQs.
FIXFLOW_OPENAI_API_KEY=
FIXFLOW_OPENAI_MODEL=gpt-4o-mini

# Optional Expo Updates URL after `eas init`
FIXFLOW_EXPO_UPDATES_URL=
